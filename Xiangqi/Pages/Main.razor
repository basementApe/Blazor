    .piece.red { color: crimson; font-weight: bold; }
    .piece.blue { color: royalblue; font-weight: bold; }

    .possible-move { background-color: #ffe08a !important; }   @* force it to override the damn river! *@
    .possible-move:hover { background-color: #ffd24d !important; }

