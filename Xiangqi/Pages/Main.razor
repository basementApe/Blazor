        vertical-align: middle;
    }
    @* .selected { outline: 3px solid gold; } *@
    @* .xiangqi td { cursor: pointer; } *@
    .xiangqi th { height: 28px; font-weight: bold; }
    .row-label { width: 28px; }
    .river td { background: #a3dffa; }
    .field td { background: #cfd6a8; }

    .xiangqi td.palace-cell
    { box-shadow: inset 0 0 0 999px rgba(163, 110, 255, 0.192); }

    .hoverable-cell {
